{
  "welcomeFile": "managepo_capm/webapp/index.html",
  "authenticationMethod": "route",
  "sessionTimeout": 10,
  "routes": [
    {
      "source": "^/-/cds/.*",
      "destination": "mtx-api",
      "authenticationType": "none"
    },
    {
      "source": "^/managepo_capm/webapp/(.*)",
      "localDir": "managepo_capm/webapp/",
      "target": "$1",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/poanalytics/webapp/(.*)",
      "localDir": "poanalytics/webapp/",
      "target": "$1",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/poanalytics_02/webapp/(.*)",
      "localDir": "poanalytics_02/webapp/",
      "target": "$1",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },    
    {
      "source": "^/user-api/currentUser$",
      "target": "/currentUser",
      "service": "sap-approuter-userapi"
    },
    {
      "source": "^/(.*)$",
      "authenticationType": "xsuaa",
      "destination": "srv-api"
    }
  ],
  "logout": {
    "logoutEndpoint": "/logout",
    "logoutPage": "https://www.anubhavtrainings.com"
  }
}